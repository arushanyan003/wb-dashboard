# Скопируй этот файл в .env и заполни своими значениями.
# В Railway эти переменные задаются в разделе Variables — .env туда заливать не нужно.

# Токен API Wildberries (раздел "Доступ к API" в личном кабинете продавца,
# категория токена должна включать "Статистика" и/или "Финансы")
WB_API_TOKEN=вставь_сюда_свой_токен

# Строка подключения к Postgres.
# Railway сам создаёт переменную DATABASE_URL при подключении плагина Postgres —
# в таком случае просто оставь это поле как есть, Railway его подставит сам.
DATABASE_URL=postgresql://user:password@localhost:5432/wb_dashboard

# С какой даты начинать собирать историю при самом первом запуске (YYYY-MM-DD).
# Данные по API доступны не раньше 29 января 2024 года.
HISTORY_START_DATE=2024-02-01
